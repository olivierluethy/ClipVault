{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipVault",
  "version": "0.1.0",
  "identifier": "net.gmx.clipvault",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ClipVault",
        "width": 900,
        "height": 640,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$DATA/clipvault/**", "$HOME/.local/share/clipvault/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Utility",
    "shortDescription": "Clipboard history manager",
    "longDescription": "ClipVault keeps a searchable history of what you copy — text, links, colors, numbers, and images — with folders, pinning, privacy mode, retention, and backups.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libxcb1", "libxcb-render0", "libxcb-shape0", "libxcb-xfixes0"]
      }
    }
  }
}
